# ============================================================================
# DTKS_BE – DreamTech Kashmir Solutions Backend Environment Configuration
# ============================================================================

# Server Port (Port 3000 for local Node adapter; 8787 for Cloudflare Wrangler)
PORT=3000
NODE_ENV="development"
ENVIRONMENT="development"

# Security & JWT Configuration (REQUIRED in production via `wrangler secret put JWT_SECRET`)
# Must be at least 32 characters in production.
JWT_SECRET="replace-with-strong-64-byte-hex-secret-in-production"
JWT_ACCESS_EXPIRY_SECONDS="900"
JWT_REFRESH_EXPIRY_SECONDS="604800"

# Initial Administrator Bootstrap Credentials
# Used ONLY when the `admins` table is empty. Never falls back to a default password.
INITIAL_ADMIN_NAME="DreamTech Kashmir Admin"
INITIAL_ADMIN_EMAIL="admin@dreamtechkashmirsolutions.studio"
INITIAL_ADMIN_PASSWORD=""

# CORS Allowed Origins (Comma-separated list of allowed origins for the separate DTKS frontend)
CORS_ALLOWED_ORIGINS="https://dreamtechkashmirsolutions.studio,https://www.dreamtechkashmirsolutions.studio,http://localhost:3000,http://localhost:5173"

# SQLite / D1 & R2 Local Persistence Paths (Used by Node runtime adapter)
SQLITE_DB_PATH="./data/dtks.sqlite"
R2_STORAGE_DIR="./data/r2-storage"

# Transactional Email Notification Provider (Resend API)
# Set in production via `wrangler secret put RESEND_API_KEY`
RESEND_API_KEY=""
EMAIL_FROM="DreamTech Kashmir Solutions <notifications@dreamtechkashmirsolutions.studio>"
ADMIN_NOTIFICATION_EMAIL="dreamtechkashmirsolutions@gmail.com"
