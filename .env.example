# ============================================================================
# DTKS – DreamTech Kashmir Solutions Environment Configuration
# ============================================================================

# Frontend API Base URL (defaults to /api/v1 when served on same origin)
VITE_API_BASE_URL="/api/v1"

# Server Port (Port 3000 required for local/container preview)
PORT=3000
NODE_ENV="development"

# Security & JWT Configuration (Set via Cloudflare Secrets in production)
JWT_SECRET="replace-with-strong-64-byte-hex-secret-in-production"
JWT_ACCESS_EXPIRES_IN="3600"
JWT_REFRESH_EXPIRES_IN="604800"

# Initial Admin Seed Configuration (Used only during initial database seed)
INITIAL_ADMIN_NAME="DTKS Principal Administrator"
INITIAL_ADMIN_EMAIL="admin@dreamtechkashmirsolutions.studio"
INITIAL_ADMIN_PASSWORD="ChangeMe_DTKS_2026!"

# CORS Allowed Origins (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS="https://dreamtechkashmirsolutions.studio,https://www.dreamtechkashmirsolutions.studio,http://localhost:3000"

# SQLite / D1 Local Persistence Path (Used by Node runtime adapter)
SQLITE_DB_PATH="./data/dtks.sqlite"
R2_STORAGE_DIR="./data/r2-storage"

# Email Notification Provider (Optional — Resend / Webhook API)
# When omitted, notifications are safely queued in the NotificationQueue table.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="notifications@dreamtechkashmirsolutions.studio"
ADMIN_NOTIFICATION_EMAIL="contact@dreamtechkashmirsolutions.studio"

# AI Studio Runtime Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://dreamtechkashmirsolutions.studio"
